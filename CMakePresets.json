{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 19 },
    "configurePresets": [
        {
            "name": "default",
            "description": "Ninja Release — system / find_package dependencies",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "INTEL_DELUXE": "ON"
            }
        },
        {
            "name": "vcpkg",
            "description": "Ninja Release — vcpkg toolchain, pre-installed packages (classic mode)",
            "inherits": ["default"],
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_MODE": "OFF"
            }
        },
        {
            "name": "vcpkg-manifest",
            "description": "Ninja Release — vcpkg manifest mode (builds deps into build/vcpkg_installed)",
            "inherits": ["default"],
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_MANIFEST_FEATURES": "base;image;vulkan;examples",
                "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
            }
        },
        {
            "name": "emscripten",
            "description": "Ninja Release — EMSDK toolchain only (no vcpkg)",
            "inherits": ["default"],
            "binaryDir": "${sourceDir}/build-emscripten",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "CMAKE_OSX_ARCHITECTURES": "",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "",
                "BUILD_ALL": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "emscripten-vcpkg",
            "description": "Ninja Release — Emscripten via vcpkg chainload (wasm32-emscripten)",
            "inherits": ["vcpkg-manifest"],
            "binaryDir": "${sourceDir}/build-emscripten",
            "cacheVariables": {
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
                "CMAKE_OSX_ARCHITECTURES": "",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "",
                "BUILD_ALL": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 0
        },
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg",
            "jobs": 0
        },
        {
            "name": "vcpkg-manifest",
            "configurePreset": "vcpkg-manifest",
            "jobs": 0
        },
        {
            "name": "emscripten",
            "configurePreset": "emscripten",
            "jobs": 0
        },
        {
            "name": "emscripten-vcpkg",
            "configurePreset": "emscripten-vcpkg",
            "jobs": 0
        }
    ]
}
